{
  "projectInfo": {
    "name": "预警参数设置系统",
    "version": "1.0.0",
    "description": "用于Axure原型设计的资源文件",
    "author": "Development Team"
  },
  "globalVariables": {
    "currentUser": {
      "name": "用户角色",
      "type": "text",
      "defaultValue": "owner",
      "options": ["owner", "contractor", "reviewer"]
    },
    "currentPage": {
      "name": "当前页面",
      "type": "text",
      "defaultValue": "settings"
    },
    "selectedWarning": {
      "name": "选中的预警",
      "type": "text",
      "defaultValue": ""
    }
  },
  "componentStyles": {
    "colors": {
      "primary": "#409EFF",
      "success": "#67C23A",
      "warning": "#E6A23C",
      "danger": "#F56C6C",
      "info": "#909399",
      "background": "#F5F7FA",
      "border": "#E4E7ED",
      "text": "#303133",
      "textSecondary": "#606266"
    },
    "fonts": {
      "primary": "PingFang SC, Microsoft YaHei, sans-serif",
      "size": {
        "small": "12px",
        "normal": "14px",
        "large": "16px",
        "title": "18px",
        "heading": "20px"
      }
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "16px",
      "lg": "24px",
      "xl": "32px"
    }
  },
  "warningTypes": [
    {
      "id": "keyword",
      "name": "关键字预警",
      "description": "检测付款备注或收款方名称中的敏感关键字",
      "defaultLevel": "medium",
      "defaultProcessType": "view_only",
      "configurable": ["level", "processType", "keywordType", "keywords"],
      "icon": "🔍"
    },
    {
      "id": "blacklist",
      "name": "黑名单预警",
      "description": "检测收款方是否在黑名单中",
      "defaultLevel": "high",
      "defaultProcessType": "direct_reject",
      "configurable": ["level", "processType", "blacklist"],
      "icon": "🚫"
    },
    {
      "id": "duplicate_payment",
      "name": "重复付款预警",
      "description": "检测相同收款方和金额的重复支付",
      "defaultLevel": "medium",
      "defaultProcessType": "owner_review",
      "configurable": ["level", "processType"],
      "icon": "🔄"
    },
    {
      "id": "frequent_payment",
      "name": "频繁付款预警",
      "description": "检测向同一收款方的频繁付款",
      "defaultLevel": "medium",
      "defaultProcessType": "owner_review",
      "configurable": ["level", "processType", "days", "times"],
      "icon": "⚡"
    },
    {
      "id": "judicial_freeze",
      "name": "司法冻结预警",
      "description": "监管账户发生司法冻结或扣划",
      "defaultLevel": "high",
      "defaultProcessType": "direct_reject",
      "configurable": ["processType"],
      "icon": "⚖️"
    },
    {
      "id": "wage_misuse",
      "name": "工资挪用预警",
      "description": "农民工工资超过历史平均水平",
      "defaultLevel": "medium",
      "defaultProcessType": "owner_review",
      "configurable": ["level", "processType", "multiplierA", "multiplierB"],
      "icon": "💰"
    },
    {
      "id": "related_party",
      "name": "关联方预警",
      "description": "向关联企业发起支付",
      "defaultLevel": "medium",
      "defaultProcessType": "owner_review",
      "configurable": ["level", "processType"],
      "icon": "🔗"
    },
    {
      "id": "payment_misuse",
      "name": "代发混用预警",
      "description": "代发资金模块进行对公账户付款",
      "defaultLevel": "medium",
      "defaultProcessType": "owner_review",
      "configurable": ["level", "processType"],
      "icon": "🔀"
    },
    {
      "id": "wage_delay_attendance",
      "name": "考勤未发预警",
      "description": "有考勤记录但未发放工资",
      "defaultLevel": "medium",
      "defaultProcessType": "view_only",
      "configurable": ["level"],
      "icon": "📅"
    },
    {
      "id": "wage_inconsistent",
      "name": "工资不一致预警",
      "description": "实发金额与应发金额不一致",
      "defaultLevel": "medium",
      "defaultProcessType": "owner_review",
      "configurable": ["level", "processType"],
      "icon": "📊"
    },
    {
      "id": "wage_overdue",
      "name": "工资超期预警",
      "description": "超过进场时间未发放工资",
      "defaultLevel": "medium",
      "defaultProcessType": "view_only",
      "configurable": ["level", "days"],
      "icon": "⏰"
    }
  ],
  "sampleData": {
