  },
  "uiComponents": {
    "warningCard": {
      "width": "360px",
      "height": "280px",
      "padding": "20px",
      "borderRadius": "8px",
      "border": "1px solid #E4E7ED",
      "boxShadow": "0 2px 12px rgba(0,0,0,0.1)",
      "elements": [
        {
          "type": "title",
          "text": "预警名称",
          "fontSize": "18px",
          "fontWeight": "bold",
          "position": "top-left"
        },
        {
          "type": "switch",
          "position": "top-right",
          "width": "40px",
          "height": "20px"
        },
        {
          "type": "status",
          "position": "below-title",
          "elements": ["dot", "text"]
        },
        {
          "type": "form",
          "position": "center",
          "elements": ["level-select", "process-select", "custom-config"]
        },
        {
          "type": "buttons",
          "position": "bottom",
          "elements": ["modify", "reset"]
        }
      ]
    },
    "warningModal": {
      "width": "600px",
      "height": "auto",
      "maxHeight": "80vh",
      "borderRadius": "8px",
      "boxShadow": "0 4px 20px rgba(0,0,0,0.3)",
      "elements": [
        {
          "type": "header",
          "height": "60px",
          "elements": ["icon", "title", "close-button"]
        },
        {
          "type": "risk-indicator",
          "height": "40px",
          "backgroundColor": "conditional"
        },
        {
          "type": "content",
          "padding": "20px",
          "elements": ["warning-info", "payment-details"]
        },
        {
          "type": "actions",
          "height": "60px",
          "elements": ["view-detail", "process", "later", "ignore"]
        }
      ]
    },
    "dataTable": {
      "width": "100%",
      "borderRadius": "4px",
      "border": "1px solid #EBEEF5",
      "elements": [
        {
          "type": "header",
          "height": "48px",
          "backgroundColor": "#F5F7FA",
          "columns": ["checkbox", "type", "level", "time", "status", "actions"]
        },
        {
          "type": "rows",
          "height": "48px",
          "alternateBackground": "#FAFAFA"
        }
      ]
    }
  },
  "interactionRules": [
    {
      "trigger": "switch-toggle",
      "condition": "warning-card",
      "action": "toggle-enabled-state",
      "effects": ["update-status-indicator", "enable-disable-form"]
    },
    {
      "trigger": "modify-button-click",
      "condition": "warning-enabled",
      "action": "open-config-dialog",
      "effects": ["show-modal", "load-current-config"]
    },
    {
      "trigger": "table-row-click",
      "condition": "warning-history",
      "action": "show-warning-detail",
      "effects": ["highlight-row", "open-detail-modal"]
    },
    {
      "trigger": "filter-change",
      "condition": "warning-history",
      "action": "update-table-data",
      "effects": ["filter-rows", "update-statistics"]
    }
  ],
  "pageFlows": [
    {
      "name": "预警配置流程",
      "steps": [
        "进入预警设置页面",
        "选择要配置的预警类型",
        "开启预警开关",
        "设置预警级别",
        "选择处置方式",
        "配置特定参数",
        "保存配置",
        "显示成功提示"
      ]
    },
    {
      "name": "预警处理流程",
      "steps": [
        "预警触发",
        "弹出预警提示",
        "用户查看预警详情",
        "选择处理方式",
        "执行处理操作",
        "更新预警状态",
        "记录处理日志"
      ]
    }
  ],
  "axureInstructions": {
    "setup": [
      "创建新的Axure RP项目",
      "导入提供的组件样式规范",
      "创建全局变量",
      "设置页面尺寸为1200px宽度",
      "创建基础组件母版"
    ],
    "implementation": [
      "按照页面布局创建静态元素",
      "添加动态面板用于状态切换",
      "配置条件逻辑和交互事件",
      "使用中继器显示列表数据",
      "添加表单验证规则"
    ],
    "testing": [
      "测试所有交互功能",
      "验证数据流转正确性",
      "检查响应式布局",
      "确认权限控制逻辑",
      "测试异常情况处理"
    ]
  }
}